{
  "expo": {
    "name": "TechVisor",
    "slug": "techvisor",
    "scheme": "techvisor",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Compare uses the camera to scan product barcodes and QR codes from boxes, shelf tags, and retailer pages.",
        "NSPhotoLibraryUsageDescription": "Compare reads a photo so you can scan a product barcode or QR code from your camera roll.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "ca.techvisor.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#445A8B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "ca.techvisor.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/ClashDisplay-Medium.ttf",
            "./assets/fonts/ClashDisplay-Semibold.ttf",
            "./assets/fonts/ClashDisplay-Bold.ttf",
            "./assets/fonts/Satoshi-Regular.ttf",
            "./assets/fonts/Satoshi-Medium.ttf",
            "./assets/fonts/Satoshi-Bold.ttf"
          ]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Compare to scan product barcodes and QR codes.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Compare to read a barcode or QR code from a photo."
        }
      ],
      "expo-router",
      "expo-sharing",
      "expo-status-bar",
      "expo-asset"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "aa04c275-a2ea-45aa-8fbf-250f88865b3f"
      }
    },
    "owner": "emayan"
  }
}
